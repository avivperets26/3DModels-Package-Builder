<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>JsonSchema.Net</AssemblyName>
    <RootNamespace>Json.Schema</RootNamespace>
    <Version>9.4.0</Version>
    <AssemblyVersion>9.0.0.0</AssemblyVersion>
    <InformationalVersion>9.4.0+PackageBuilder.MIT.399f198431f65cf6896fe6038f833ef6d0b27a39</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../upstream/src/JsonSchema/**/*.cs" Exclude="../upstream/src/JsonSchema/PropertyDependenciesKeyword.cs;../upstream/src/JsonSchema/PropertyDependency.cs" />
    <ProjectReference Include="../JsonPointer.Net/JsonPointer.Net.csproj" />
    <EmbeddedResource Include="../upstream/Meta-Schemas/**/*.json"
                      Exclude="../upstream/Meta-Schemas/OpenAPI/**;../upstream/Meta-Schemas/array-ext.json;../upstream/Meta-Schemas/data-2023.json"
                      Link="Meta-Schemas/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../upstream/src/JsonSchema/Localization/Resources.resx"
                      LogicalName="Json.Schema.Localization.Resources.resources" />
  </ItemGroup>
</Project>
