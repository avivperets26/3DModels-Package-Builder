<Window x:Class="PackageBuilder.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Package Builder"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ShellBackgroundBrush}"
        AutomationProperties.Name="Package Builder main window">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource NavigationBrush}">
            <Grid Margin="20,22,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36"
                            Height="36"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="PB" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextOnDarkBrush}"
                                   Text="{Binding ApplicationName}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextOnDarkMutedBrush}"
                                   Text="{Binding ReleaseLabel}" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1"
                           Margin="4,34,0,8"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextOnDarkMutedBrush}"
                           Text="WORKSPACE" />

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Modules}"
                         SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         KeyboardNavigation.TabNavigation="Local"
                         AutomationProperties.Name="Primary navigation">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        HorizontalAlignment="Left"
                                        Background="#24334C"
                                        CornerRadius="6">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                               Text="{Binding Glyph}" />
                                </Border>
                                <AccessText Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="{Binding AccessKeyLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3"
                        Padding="12"
                        Background="#18243A"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextOnDarkBrush}"
                                   Text="PRIVATE BY DEFAULT" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextOnDarkMutedBrush}"
                                   Text="{Binding PrivacyLabel}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="44,32,44,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Text="{Binding CurrentModule.Eyebrow}" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding CurrentModule.NavigationLabel}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="12,7"
                        VerticalAlignment="Center"
                        Background="#E1F3ED"
                        CornerRadius="16">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{StaticResource SuccessBrush}" />
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Text="{Binding CurrentModule.Readiness}" />
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel Margin="0,0,8,0">
                    <Border Padding="32"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,4,32,4">
                                <TextBlock MaxWidth="720"
                                           HorizontalAlignment="Left"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding CurrentModule.Title}"
                                           TextWrapping="Wrap" />
                                <TextBlock MaxWidth="720"
                                           Margin="0,16,0,0"
                                           HorizontalAlignment="Left"
                                           FontSize="15"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           LineHeight="23"
                                           Text="{Binding CurrentModule.Description}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    MinHeight="138"
                                    Padding="20"
                                    Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#315C9C"
                                               Text="SAFE NEXT STEP" />
                                    <TextBlock Margin="0,10,0,0"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               LineHeight="20"
                                               Text="{Binding CurrentModule.NextStep}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <ItemsControl Margin="0,22,0,0" ItemsSource="{Binding CurrentModule.Highlights}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,14,0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinHeight="156"
                                        Padding="22"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding Label}" />
                                        <TextBlock Margin="0,9,0,0"
                                                   FontSize="21"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="{Binding Value}" />
                                        <TextBlock Margin="0,10,0,0"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   LineHeight="18"
                                                   Text="{Binding Detail}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,22,0,0"
                            Padding="18,15"
                            Background="{StaticResource SurfaceMutedBrush}"
                            CornerRadius="10">
                        <TextBlock FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="This is the first visual shell. Actions that could change files or publish packages remain unavailable until their validated workflows are implemented."
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Package Builder · Local workstation" />
                <TextBlock Grid.Column="1"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Keyboard: Tab, arrows, Alt+O/P/B/V/S" />
            </Grid>
        </Grid>
    </Grid>
</Window>
