<Window x:Class="PackageBuilder.App.Wpf.StartupFailureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Package Builder startup problem"
        Width="620"
        Height="410"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource ShellBackgroundBrush}"
        AutomationProperties.Name="Package Builder startup problem">
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Width="52"
                Height="52"
                HorizontalAlignment="Left"
                Background="#FDE5E5"
                CornerRadius="14">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#B42318"
                       Text="!" />
        </Border>
        <StackPanel Grid.Row="1" Margin="0,24,0,24">
            <TextBlock FontSize="25"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Text="{Binding Title}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,14,0,0"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       LineHeight="22"
                       Text="{Binding Message}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,12,0,0"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding Guidance}"
                       TextWrapping="Wrap" />
            <Border Margin="0,20,0,0"
                    Padding="12,9"
                    HorizontalAlignment="Left"
                    Background="{StaticResource SurfaceMutedBrush}"
                    CornerRadius="6">
                <TextBlock FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding ErrorCode}" />
            </Border>
        </StackPanel>
        <Button Grid.Row="2"
                MinWidth="110"
                Padding="18,9"
                HorizontalAlignment="Right"
                IsCancel="True"
                IsDefault="True"
                Content="_Close"
                AutomationProperties.Name="Close Package Builder" />
    </Grid>
</Window>
