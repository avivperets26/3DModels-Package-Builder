{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.packagebuilder.dev/publisher-profile/v1",
  "title": "Package Builder publisher profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "root",
    "displayName",
    "supportContact",
    "copyright",
    "aiDisclosure"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "root": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "displayName": {
      "$ref": "#/$defs/shortText"
    },
    "supportContact": {
      "$ref": "#/$defs/supportContact"
    },
    "copyright": {
      "$ref": "#/$defs/copyright"
    },
    "aiDisclosure": {
      "$ref": "#/$defs/aiDisclosure"
    },
    "branding": {
      "$ref": "#/$defs/branding"
    }
  },
  "$defs": {
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:[^\\u0000-\\u001F\\u007F]*\\S)?$"
    },
    "supportContact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "email",
            "secure-url"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\s\\u0000-\\u001F\\u007F]+$"
        }
      }
    },
    "copyright": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holder",
        "yearPolicy"
      ],
      "properties": {
        "holder": {
          "$ref": "#/$defs/shortText"
        },
        "yearPolicy": {
          "$ref": "#/$defs/yearPolicy"
        }
      }
    },
    "yearPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "year"
          ],
          "properties": {
            "kind": {
              "const": "single-year"
            },
            "year": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "startYear",
            "year"
          ],
          "properties": {
            "kind": {
              "const": "year-range"
            },
            "startYear": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            },
            "year": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "year"
          ],
          "properties": {
            "kind": {
              "const": "publication-year"
            },
            "year": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            }
          }
        }
      ]
    },
    "aiDisclosure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "undeclared"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "no-ai-assistance"
            },
            "text": {
              "$ref": "#/$defs/disclosureText"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "ai-assisted"
            },
            "text": {
              "$ref": "#/$defs/disclosureText"
            }
          }
        }
      ]
    },
    "disclosureText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^\\S(?:[^\\u0000-\\u001F\\u007F]*\\S)?$"
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "images"
      ],
      "properties": {
        "images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/brandingImage"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "role": {
                    "const": "logo"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "role": {
                    "const": "watermark"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            }
          ]
        }
      }
    },
    "brandingImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "source"
      ],
      "properties": {
        "role": {
          "enum": [
            "logo",
            "watermark"
          ]
        },
        "source": {
          "$ref": "#/$defs/imageSource"
        }
      }
    },
    "imageSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "logicalReference"
      ],
      "properties": {
        "kind": {
          "const": "image"
        },
        "logicalReference": {
          "$ref": "#/$defs/logicalReference"
        },
        "originalFileName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\\\u0000-\\u001F\\u007F]+$"
        }
      }
    },
    "logicalReference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)(?!.*:)(?!.*[\\u0000-\\u001F\\u007F])\\S(?:.*\\S)?$"
    }
  }
}
