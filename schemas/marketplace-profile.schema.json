{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.packagebuilder.dev/marketplace-profile/v1",
  "title": "Package Builder marketplace identity profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "marketplace",
    "profile"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "marketplace": {
      "$ref": "#/$defs/extensibleIdentifier"
    },
    "profile": {
      "$ref": "#/$defs/extensibleIdentifier"
    }
  },
  "$defs": {
    "extensibleIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    }
  }
}
