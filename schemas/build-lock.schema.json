{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.packagebuilder.dev/build-lock/v1",
  "title": "Package Builder deterministic build lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "packageBuilderVersion",
    "dotnetSdk",
    "blender",
    "unity",
    "unreal",
    "manifestSchemaVersion",
    "workers",
    "marketplaceProfiles"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "$ref": "#/$defs/identity" },
    "packageBuilderVersion": { "$ref": "#/$defs/version" },
    "dotnetSdk": { "$ref": "#/$defs/version" },
    "blender": { "$ref": "#/$defs/version" },
    "unity": { "$ref": "#/$defs/version" },
    "unreal": { "$ref": "#/$defs/version" },
    "manifestSchemaVersion": { "type": "integer", "minimum": 1 },
    "workers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/versionedComponent" }
    },
    "marketplaceProfiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/versionedMarketplaceProfile" }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[^\\u0000-\\u001F\\u007F]*\\S)?$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "versionedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "id", "version" ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "versionedMarketplaceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "marketplace", "profile", "version" ],
      "properties": {
        "marketplace": { "$ref": "#/$defs/identifier" },
        "profile": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" }
      }
    }
  }
}
